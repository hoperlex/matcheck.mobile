<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path name="operation_photos" path="operation_photos/" />
    <!-- Снимки нового pipeline (RemotePhotoStorage: filesDir/remote_photos).
         Раздаются наружу только при ручном экспорте карантина чужого объекта
         из «Очереди синхронизации» — ACTION_SEND_MULTIPLE с временным
         read-grant, без копирования файлов. -->
    <files-path name="remote_photos" path="remote_photos/" />
    <!-- Каталог скачанного APK обновления. Лежит в app-private external
         storage (Context.getExternalFilesDir("updates")), не требует
         WRITE_EXTERNAL_STORAGE и автоматически чистится при удалении
         приложения. FileProvider раздаёт content://-URI системному
         installer'у, чтобы ACTION_VIEW открыл диалог установки. -->
    <external-files-path name="app_updates" path="updates/" />
    <!-- Журнал инцидентов (IncidentJournal: filesDir/diag). Отдаётся наружу
         только по кнопке «Поделиться журналом» в «Очереди синхронизации».
         ПДн внутри нет — маршруты, этапы, флаги и таймстемпы. -->
    <files-path name="diag" path="diag/" />
</paths>
