<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background для приложения «su10». Сплошной фирменный синий
  (Material Blue 800) — простая монохромная заливка 108x108dp viewport,
  Android сам обрежет под текущую системную форму иконки (круг / squircle /
  квадрат / каплевидную и т. д.). Foreground — отдельный vector с буквой «S»
  по центру (см. ic_launcher_foreground.xml).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1565C0"
        android:pathData="M0,0h108v108h-108z" />
</vector>
