<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground адаптивной иконки «Матбаланс»: белая монограмма-«M» по центру
  108×108 viewport. Safe zone (примерно 18..90) под Android-shape mask
  соблюдается — буква умещается с запасом. Текст «Матбаланс» под иконкой
  Android выводит сам из app_name (см. values/strings.xml).

  «M» нарисована как stroke-path с скруглёнными концами и стыками
  (strokeLineCap/Join=round) — на разных формах иконки (круг / squircle /
  квадрат) смотрится одинаково. Та же толщина (12) и тот же белый stroke
  на синем фоне (#1565C0, см. ic_launcher_background.xml), что были у «S».
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,80 L32,30 L54,60 L76,30 L76,80" />
</vector>
